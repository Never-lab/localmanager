{
  "name": "localmanager",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "localmanager",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20.19.0"
      }
    },
    "node_modules/@localmanager/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@localmanager/shared"
    }
  }
}
